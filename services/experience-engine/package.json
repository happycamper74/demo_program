{
  "name": "@experience-platform/experience-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./experience-definitions": {
      "types": "./dist/experience-definitions.d.ts",
      "import": "./dist/experience-definitions.js"
    },
    "./experience-sessions": {
      "types": "./dist/experience-sessions.d.ts",
      "import": "./dist/experience-sessions.js"
    },
    "./experience-prospects": {
      "types": "./dist/experience-prospects.d.ts",
      "import": "./dist/experience-prospects.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@experience-platform/shared-types": "workspace:*",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
